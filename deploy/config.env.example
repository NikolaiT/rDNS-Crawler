# rDNS-Crawler distributed deploy configuration.
# Copy to config.env and fill in. config.env is gitignored (contains a secret).

# Hetzner Cloud API token (Project → Security → API Tokens, Read & Write).
HCLOUD_TOKEN=your-hetzner-cloud-api-token-here

# Number of crawler nodes (= number of shards). Each node gets its own public IP.
NODES=5

# Server type. NB: the "cx" (Intel) line is EU-only (nbg1/fsn1/hel1). If you want
# US locations too, use an AMD "cpx" type (e.g. cpx22), which exists everywhere.
SERVER_TYPE=cx23

# Base image.
IMAGE=ubuntu-24.04

# Locations to spread nodes across (round-robin). More locations = more IP/geo
# diversity. cx23 is limited to these three EU sites.
LOCATIONS="nbg1 fsn1 hel1"

# Name prefix + SSH key for the servers.
SERVER_PREFIX=rdns
SSH_KEY_NAME=rdns-crawler
SSH_KEY_FILE=$HOME/.ssh/id_ed25519

# Crawl tuning passed to each node's crawler.
#
# TIMEOUT/RETRIES trade coverage against speed. A short timeout + few retries
# maximizes throughput on a first full sweep but classifies slow authoritative
# servers as `timeout`. On a re-crawl aimed at recovering those slow responders,
# raise the timeout (e.g. 5s) and retries (e.g. 2) — you revisit far fewer IPs
# the second time, so the lower per-query speed is an easy trade. Keep
# CONCURRENCY at 800 on a 2-vCPU box: a longer timeout already leaves more slots
# waiting, so raising concurrency would only stress the node and local resolver.
CONCURRENCY=800
TIMEOUT=3s
RETRIES=2
# Optional per-node cap (0 = crawl the whole shard). Handy for a first test run.
LIMIT=0

# Fraction of the routable IPv4 space to crawl, as a percentage.
#   100 = full space (production)
#     2 = a random, evenly-distributed 2% test sample (~74M IPs, split across NODES)
# The sample is a deterministic hash of the IP, so every pass hits the same set
# (good for testing re-crawl/update logic) and it is split evenly across nodes.
SAMPLE_PERCENT=2
